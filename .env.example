# Copy to .env.local and fill in. Nothing here is needed to run the dev server —
# without any of it you still get the development sign-in personas.

# Signs the session cookie. Required in production.
#   openssl rand -base64 32
AUTH_SECRET=

# The key that turns "google + 1098765..." into your pseudonymous uid.
# Required in production, 32+ characters.
# Changing it invalidates every uid in every access file — which is also your
# emergency "revoke everyone" lever.
#   openssl rand -base64 32
KINFOLD_PEPPER=

# Optional. Add either pair to switch real sign-in on.
# Google:  https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub:  https://github.com/settings/developers
#   Authorisation callback URL: https://YOUR-DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Where tree and access JSON live. Defaults to ./data
# KINFOLD_DATA_DIR=/var/lib/kinfold
